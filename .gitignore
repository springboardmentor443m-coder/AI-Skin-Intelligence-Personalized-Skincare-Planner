# ── AI Skin Intelligence — Root .gitignore ────────────────────────────────────

# ── Phase 7: ML pipeline ──────────────────────────────────────────────────────

# Dataset images — too large for Git (~2.4 GB)
ml/dataset/HAM10000/images/
ml/dataset/HAM10000/*.jpg
ml/dataset/HAM10000/*.zip

# Keep the .gitkeep file so the folder is tracked
!ml/dataset/HAM10000/images/.gitkeep

# Metadata CSV can be committed (it's small, ~500 KB)
# Remove the next line if you want to commit it:
# ml/dataset/HAM10000/HAM10000_metadata.csv

# Trained model files — large binary files (~20 MB+)
ml/models/*.pt
ml/models/*.pth
ml/models/*.onnx
# Keep .gitkeep so the models/ directory is tracked
!ml/models/.gitkeep

# Training artefacts (regenerated by running training)
ml/models/training_curves.png
ml/models/confusion_matrix.png
ml/models/training_history.json
ml/models/test_metrics.json

# Python cache
ml/__pycache__/
ml/src/__pycache__/
ml/venv/

# Sample images (add real ones manually)
!ml/sample_images/.gitkeep

# ── Backend ───────────────────────────────────────────────────────────────────
backend/.env
backend/venv/
backend/__pycache__/
backend/**/__pycache__/

# ── Frontend ──────────────────────────────────────────────────────────────────
frontend/.env
frontend/.env.*
!frontend/.env.example
frontend/node_modules/
frontend/dist/

# ── General ───────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.log
