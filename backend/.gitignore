# ── Files/folders to EXCLUDE from Git ────────────────────────────────────────

# Python virtual environment — never commit this, it's too large
venv/
env/
.venv/

# Python compiled bytecode — auto-generated, not needed in version control
__pycache__/
*.py[cod]
*.pyo

# Environment variables — contains sensitive config, never commit
.env

# IDE/editor folders
.vscode/
.idea/

# OS-generated files
.DS_Store
Thumbs.db
